                      "diff_curr = avg_curr - head_curr;"
                      "a = (diff_curr / (bunch_length1/2)) / avg_curr;"
                      "b = 50e-6;"
                      "ylo = -bunch_length1/2;"
                      "yhi = bunch_length1/2;"
    "lower = b*(sqrt(pi/2)*(1 - a*z)*erf(((1/sqrt(2))*(ylo - z))/b) +
    a*b*exp(-(0.5*(ylo - z)^2)/b^2));"
    "upper = b*(sqrt(pi/2)*(1 - a*z)*erf(((1/sqrt(2))*(yhi - z))/b) +
    a*b*exp(-(0.5*(yhi - z)^2)/b^2));"
                      "upper - lower");

